   ============================================================ */
function renderFaq(){
  const d = T().faq, k = T().kycRequired, t = T();
  const q = (state.faqQuery||'').toLowerCase();
  const kycReqHtml = `
    <div class="section-block">
      <div class="section-title">${esc(k.alwaysTitle)}</div>
      <div class="table-wrap"><table><thead><tr><th style="width:45%">Situation</th><th>Requirement</th></tr></thead><tbody>
        ${k.alwaysRows.map(r=>`<tr><td><strong>${esc(r.situation)}</strong></td><td>${esc(r.requirement)}</td></tr>`).join('')}
      </tbody></table></div>
    </div>
    <div class="section-block">
      <div class="section-title">${esc(k.notRequiredTitle)}</div>
      <div class="card"><p>${esc(k.notRequiredText)}</p></div>
    </div>
    ${calloutHtml(k.note)}`;
  const kycReqSearchText = (k.alwaysRows.map(r=>r.situation+' '+r.requirement).join(' ') + ' ' + k.notRequiredText + ' ' + stripTags(k.note.html)).toLowerCase();
  const allItems = [
    { key:'faq-kyc-required', q:k.question, bodyHtml:kycReqHtml, searchText:k.question.toLowerCase()+' '+kycReqSearchText },
    ...d.items.map((it,i)=>({ key:'faq'+i, q:it.q, bodyHtml:`<p>${esc(it.a)}</p>`, searchText:(it.q+' '+it.a).toLowerCase() }))
  ];
  const items = allItems.filter(it => !q || it.searchText.includes(q));
  return `
  ${pageHead(d.eyebrow, d.title, d.subtitle)}
  <input type="text" class="faq-search" id="faqSearchInput" data-focus-key="faq-search" placeholder="${esc(t.ui.searchPlaceholder)}" value="${esc(state.faqQuery||'')}" data-action-input="faq-filter">
  <div>
    ${items.length? items.map(it=>{
      const open = !!state.faqOpen[it.key] || !!q;
      return `<div class="accordion-item ${open?'open':''}">
        <button class="accordion-head" data-action="accordion" data-key="${it.key}">
          <span>${esc(it.q)}</span>
          <span class="chev">${icon('chevron')}</span>
        </button>
        <div class="accordion-body">${it.bodyHtml}</div>
      </div>`;
    }).join('') : `<p class="muted">${esc(t.ui.common.noResults)}</p>`}
  </div>`;
}

