function renderRaciTableOnly(){
  const d = T().raci, t = T();
  const roleOrder = d.roleOrder;
  const onlyRole = state.role !== 'all' ? state.role : null;
  const rows = onlyRole ? d.tasks.filter(r => r.cells && r.cells[onlyRole]) : d.tasks;
  return `<div class="table-wrap"><table><thead><tr><th style="width:26%">Task</th>
    ${roleOrder.map(r=>`<th class="center">${esc(t.ui.roles[r])}</th>`).join('')}
  </tr></thead><tbody>
    ${rows.map(r=>`<tr>
      <td>${esc(r.task)}</td>
      ${roleOrder.map(rid=>{
        const v = r.cells && r.cells[rid];
        const isSelf = rid===onlyRole;
        const strong = v==='does'||v==='decides';
        return `<td class="center" style="${isSelf?'background:var(--accent-soft);':''}">${v?`<span style="${strong?'font-weight:700;':'color:var(--ink-2);'}">${esc(d.cellLabel[v])}</span>`:''}</td>`;
      }).join('')}
    </tr>`).join('')}
  </tbody></table></div>
  ${!onlyRole ? `<p class="muted small" style="margin-top:10px;">${esc(t.ui.roleAllLabel)} — select a role above to filter this table and highlight your responsibilities across the whole site.</p>` : ''}`;
}

function renderRoleTimeline(){
  const d = T().roleTimeline, t = T(), ph = T().phases;
  const timelineHtml = `<div class="timeline">${ph.list.map(p=>`
    <button class="tl-phase ${state.tlOpenPhase===p.id?'active':''}" data-action="tl-open" data-id="${p.id}">
