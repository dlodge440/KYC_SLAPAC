   ============================================================ */
function calloutHtml(c){
  if(!c) return '';
  const cls = c.type && c.type!=='plain' ? ' '+c.type : '';
  return `<div class="callout${cls}">${c.html}</div>`;
}
const ROLE_IDS = ['broker','backoffice','finance','compliance','cso'];
function roleBadge(roleId, extraCls){
  const t = T();
  const label = t.ui.roles[roleId] || roleId;
  return `<span class="badge role-${roleId} ${extraCls||''}" data-role-badge="${roleId}">${esc(label)}</span>`;
}

