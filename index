function currentWizardStepId(){
  const a = state.wizard.answers;
  const order = ['type'];
  if(a.buyerType==='private') order.push('jurisdiction');
  order.push('tradein','brandrep','results');
  return order[Math.min(state.wizard.step-1, order.length-1)];
}
function wizardCanAdvance(sid){
  const a = state.wizard.answers;
  if(sid==='type') return !!a.buyerType;
  if(sid==='jurisdiction') return a.buyerType!=='private' || (!!a.jurisdiction && a.individualsAlready!==null);
  if(sid==='tradein') return a.tradeIn!==null;
  if(sid==='brandrep') return a.brandRep!==null && (!a.brandRep || a.brandRepFresh!==null);
  return true;
}
function wizardSet(field, value){
  const a = state.wizard.answers;
  let v = value;
  if(v==='true') v = true; else if(v==='false') v = false;
  a[field] = v;
  if(field==='buyerType'){ a.jurisdiction=null; a.individualsAlready=null; }
  if(field==='brandRep' && v!==true) a.brandRepFresh=null;
  render();
}
function wizardNext(){
  const sid = currentWizardStepId();
  if(!wizardCanAdvance(sid)) return;
  state.wizard.step++;
  render();
}
function wizardBack(){ state.wizard.step = Math.max(1, state.wizard.step-1); render(); }
function wizardRestart(){ state.wizard = { step:1, answers:{ buyerType:null, jurisdiction:null, individualsAlready:null, tradeIn:null, brandRep:null, brandRepFresh:null } }; render(); }

