<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="robots" content="noindex, nofollow">
<title>KYC &amp; Sanctions Compliance Guidelines — Simpson Marine</title>
<style>

@font-face{
  font-family:'PPNeueMontreal';
  src:url(data:font/woff2;charset=utf-8;base64,) format("woff2-variations");
  font-weight:100 900;
  font-display:swap;
}
/* ============================================================
   DESIGN TOKENS
   ============================================================ */
:root{
  --bg:#ffffff;
  --surface:#ffffff;
  --surface-alt:#f6f6f6;
  --border:#e4e4e4;
  --border-strong:#000000;
  --ink:#000000;
  --ink-2:#4d4d4d;
  --ink-3:#8c8c8c;
  --accent:#000000;
  --accent-hover:#2b2b2b;
  --accent-ink:#ffffff;
  --accent-soft:#f2f2f2;
  --accent-soft-ink:#000000;
  --danger:#c81e0e;
  --danger-soft:#fdf1ef;
  --danger-ink:#8f1c0f;
  --warn:#b5730a;
  --warn-soft:#fbf3e6;
  --warn-ink:#7a4a08;
  --success:#000000;
  --success-soft:#f2f2f2;
  --success-ink:#000000;
  --sidebar-bg:#ffffff;
  --sidebar-ink:#4d4d4d;
  --sidebar-ink-dim:#9a9a9a;
  --sidebar-active-bg:#f2f2f2;
  --sidebar-active-ink:#000000;
  --sidebar-border:#e4e4e4;
  --sidebar-accent:#000000;
  --radius-lg:2px;
  --radius:2px;
  --radius-sm:1px;
  --shadow-sm:none;
  --shadow-md:0 4px 8px rgba(0,0,0,.08);
  --shadow-lg:0 12px 32px rgba(0,0,0,.12);
  --font:'PPNeueMontreal',-apple-system,BlinkMacSystemFont,"Helvetica Neue","PingFang SC","Microsoft YaHei",Arial,sans-serif;
  --mono:ui-monospace,SFMono-Regular,"SF Mono",Consolas,"Liberation Mono",monospace;
  --topbar-h:64px;
  --sidebar-w:272px;
  --tracked:.08em;
}

/* ============================================================
   RESET & BASE
   ============================================================ */
*,*::before,*::after{box-sizing:border-box;}
html,body{height:100%;}
body{
  margin:0;
  font-family:var(--font);
  background:var(--bg);
  color:var(--ink);
  font-size:15px;
  line-height:1.55;
  -webkit-font-smoothing:antialiased;
  text-rendering:optimizeLegibility;
}
h1,h2,h3,h4,h5,p,ul,ol,dl,dd{margin:0;}
ul,ol{padding-left:1.25em;}
a{color:var(--accent);text-decoration:underline;text-underline-offset:2px;text-decoration-thickness:1px;}
button,input,select,textarea{font-family:inherit;font-size:inherit;color:inherit;}
button{cursor:pointer;}
svg{display:block;}
:focus-visible{outline:2.5px solid var(--accent);outline-offset:2px;border-radius:4px;}
[lang="zh"]{font-feature-settings:"palt";}

/* scrollbar */
.scroll-area{scrollbar-width:thin;scrollbar-color:var(--border-strong) transparent;}
.scroll-area::-webkit-scrollbar{width:9px;height:9px;}
.scroll-area::-webkit-scrollbar-thumb{background:var(--border-strong);border-radius:8px;}

/* ============================================================
   APP SHELL
   ============================================================ */
#app{min-height:100%;}

.topbar{
  position:fixed;top:0;left:0;right:0;height:var(--topbar-h);
  background:hsla(0,0%,100%,.86);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);
  border-bottom:.3px solid #000;
  display:flex;align-items:center;gap:14px;padding:0 22px;
  z-index:200;
}
.topbar .brand{
  display:flex;align-items:center;gap:10px;font-weight:500;letter-spacing:.01em;
  white-space:nowrap;color:var(--ink);
}
.topbar .brand-mark{
  width:30px;height:30px;border-radius:0;background:#000;
  display:flex;align-items:center;justify-content:center;color:#fff;font-weight:500;font-size:12px;letter-spacing:.02em;flex:none;
}
.topbar .brand-text{display:flex;flex-direction:column;line-height:1.2;}
.topbar .brand-text .t1{font-size:12.5px;font-weight:500;letter-spacing:.03em;}
.topbar .brand-text .t2{font-size:9.5px;color:var(--ink-3);font-weight:500;letter-spacing:.1em;text-transform:uppercase;}

.menu-toggle{display:none;}

.topbar-search{
  flex:1 1 auto;max-width:460px;position:relative;
}
.topbar-search input{
  width:100%;padding:8px 34px 8px 24px;border-radius:0;border:none;border-bottom:.4px solid #000;
  background:transparent;color:var(--ink);font-size:13px;letter-spacing:.01em;
}
.topbar-search input:focus{background:transparent;border-color:#000;}
.topbar-search .icon{position:absolute;left:0;top:50%;transform:translateY(-50%);color:var(--ink);pointer-events:none;}
.topbar-search .kbd{position:absolute;right:2px;top:50%;transform:translateY(-50%);font-size:10px;color:var(--ink-3);border:.3px solid var(--border);border-radius:2px;padding:1px 6px;background:var(--surface);}

.search-results{
  position:absolute;top:calc(100% + 14px);left:0;right:0;background:var(--surface);
  border:none;border-radius:0;box-shadow:var(--shadow-md);
  max-height:60vh;overflow:auto;display:none;z-index:300;
}
.search-results.open{display:block;}
.search-results .sr-item{display:block;width:100%;text-align:left;padding:12px 16px;border:0;background:none;border-bottom:.3px solid var(--border);}
.search-results .sr-item:last-child{border-bottom:0;}
.search-results .sr-item:hover,.search-results .sr-item.active{background:var(--accent-soft);}
.search-results .sr-cat{font-size:10px;text-transform:uppercase;letter-spacing:.1em;color:var(--ink-3);font-weight:500;margin-bottom:4px;}
.search-results .sr-title{font-weight:500;font-size:13.5px;margin-bottom:3px;}
.search-results .sr-snip{font-size:12.5px;color:var(--ink-2);}
.search-results .sr-empty{padding:16px;color:var(--ink-3);font-size:13px;}
.search-results mark{background:none;color:var(--ink);font-weight:600;text-decoration:underline;text-decoration-thickness:1.5px;text-underline-offset:2px;}

.topbar-controls{display:flex;align-items:center;gap:20px;flex:none;}
.pillselect{position:relative;}
.pillselect select{
  appearance:none;-webkit-appearance:none;
  padding:0 20px 0 0;border-radius:0;border:none;border-bottom:.4px solid #000;
  background:transparent;font-size:11px;font-weight:500;letter-spacing:.08em;text-transform:uppercase;color:var(--ink);
  height:24px;
}
.pillselect::after{
  content:"";position:absolute;right:2px;top:50%;width:6px;height:6px;
  border-right:1.3px solid var(--ink);border-bottom:1.3px solid var(--ink);
  transform:translateY(-70%) rotate(45deg);pointer-events:none;
}
.langtoggle{
  display:flex;align-items:center;gap:8px;
}
.langtoggle button{
  border:0;background:none;padding:0;font-size:11px;font-weight:400;letter-spacing:.06em;color:var(--ink-3);text-transform:uppercase;
}
.langtoggle button.active{font-weight:600;color:var(--ink);text-decoration:underline;text-underline-offset:3px;}

/* Sidebar */
.sidebar{
  position:fixed;top:var(--topbar-h);left:0;bottom:0;width:var(--sidebar-w);
  background:var(--sidebar-bg);border-right:.3px solid #000;
  overflow-y:auto;padding:28px 14px 40px;z-index:150;
}
.sidebar-group{margin-bottom:26px;}
.sidebar-label{
  font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--sidebar-ink-dim);
  font-weight:500;padding:0 12px;margin-bottom:10px;display:block;
}
.sidebar-link{
  display:flex;align-items:center;gap:10px;width:100%;text-align:left;border:0;background:none;
  color:var(--sidebar-ink);padding:8px 12px;border-radius:0;font-size:13px;font-weight:400;letter-spacing:.01em;
  margin-bottom:1px;line-height:1.35;
}
.ic{width:18px;height:18px;display:inline-block;flex:none;vertical-align:middle;}
.sidebar-link .ic{width:15px;height:15px;opacity:.65;}
.sidebar-link:hover{background:var(--sidebar-active-bg);color:var(--sidebar-active-ink);}
.sidebar-link.active{background:var(--sidebar-active-bg);color:var(--sidebar-active-ink);font-weight:600;box-shadow:inset 2px 0 0 var(--sidebar-accent);}
.sidebar-link .badge-count{margin-left:auto;font-size:10px;background:var(--sidebar-active-bg);color:var(--sidebar-ink);border-radius:999px;padding:1px 7px;}
.sidebar-foot{padding:14px 12px;border-top:.3px solid #000;margin-top:8px;font-size:10.5px;color:var(--sidebar-ink-dim);line-height:1.6;letter-spacing:.01em;}

.sidebar-scrim{display:none;}

/* Main */
.main-wrap{margin-left:var(--sidebar-w);padding-top:var(--topbar-h);height:100vh;overflow-y:auto;overflow-x:hidden;scrollbar-width:thin;scrollbar-color:var(--border-strong) transparent;}
.main-wrap::-webkit-scrollbar{width:9px;}
.main-wrap::-webkit-scrollbar-thumb{background:var(--border-strong);border-radius:8px;}
.main{max-width:980px;margin:0 auto;padding:32px 36px 90px;}
.main.wide{max-width:1180px;}

.page-head{margin-bottom:32px;}
.page-eyebrow{font-size:11px;font-weight:500;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-3);margin-bottom:10px;}
.page-title{font-size:34px;font-weight:300;letter-spacing:-.005em;margin-bottom:10px;line-height:1.15;}
.page-sub{font-size:14.5px;color:var(--ink-2);max-width:70ch;font-weight:400;}

/* ============================================================
   COMPONENTS
   ============================================================ */
.card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-lg);padding:24px;box-shadow:var(--shadow-sm);}
.card + .card{margin-top:16px;}
.section-title{font-size:16px;font-weight:500;margin-bottom:12px;letter-spacing:-.005em;}
.section-block{margin-bottom:28px;}
.muted{color:var(--ink-2);}
.small{font-size:12.5px;}
.mono{font-family:var(--mono);}

.callout{
  border-radius:0;padding:14px 18px;font-size:14px;line-height:1.6;
  border:0;border-left:3px solid var(--ink-3);background:var(--surface-alt);position:relative;
}
.callout.rule{background:var(--surface-alt);border-left-color:#000;color:var(--ink);}
.callout.danger{background:var(--danger-soft);border-left-color:var(--danger);color:var(--danger-ink);}
.callout.warn{background:var(--warn-soft);border-left-color:var(--warn);color:var(--warn-ink);}
.callout b,.callout strong{font-weight:600;}

.badge{display:inline-flex;align-items:center;gap:5px;font-size:10px;font-weight:500;padding:3px 8px;border-radius:0;letter-spacing:.06em;text-transform:uppercase;white-space:nowrap;border:1px solid var(--ink);background:transparent;color:var(--ink);}
.badge.role-all{border-color:var(--border);color:var(--ink-2);}
.badge.dim{opacity:.4;}
.badge.hl{background:var(--ink);color:#fff;}
.role-block{transition:opacity .15s ease;}
.role-block.dim{opacity:.42;}

table{border-collapse:collapse;width:100%;font-size:13.5px;}
.table-wrap{overflow-x:auto;border:1px solid var(--border);border-radius:var(--radius);}
table th,table td{padding:11px 14px;text-align:left;border-bottom:.3px solid var(--border);vertical-align:top;}
table thead th{background:var(--surface-alt);font-size:11px;text-transform:uppercase;letter-spacing:.08em;color:var(--ink-2);font-weight:500;position:sticky;top:0;border-bottom:1px solid #000;}
table tbody tr:last-child td{border-bottom:0;}
table tbody tr:hover{background:var(--accent-soft);}
td.center,th.center{text-align:center;}

.pill{display:inline-block;padding:2px 8px;border-radius:0;font-size:10px;font-weight:500;letter-spacing:.05em;text-transform:uppercase;}
.pill.yes{background:#000;color:#fff;}
.pill.partial{background:transparent;color:var(--ink);border:1px solid var(--ink);}
.pill.no{background:var(--surface-alt);color:var(--ink-3);}

.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:8px;border-radius:0;border:1px solid #000;
  background:transparent;color:#000;font-weight:500;font-size:11.5px;letter-spacing:.06em;text-transform:uppercase;padding:12px 24px;line-height:1.2;
  transition:background .2s ease,color .2s ease,border-color .2s ease;
}
.btn:hover{background:#000;color:#fff;}
.btn.primary{background:#000;border-color:#000;color:#fff;}
.btn.primary:hover{background:#2b2b2b;border-color:#2b2b2b;}
.btn.ghost{border-color:transparent;background:none;padding:12px 4px;}
.btn.ghost:hover{background:none;color:#000;text-decoration:underline;text-underline-offset:3px;}
.btn.sm{padding:8px 14px;font-size:10.5px;}
.btn:disabled{opacity:.35;cursor:not-allowed;}
.btn:disabled:hover{background:transparent;color:#000;}
.btn.danger-o{color:var(--danger);border-color:var(--danger);}
.btn.danger-o:hover{background:var(--danger);color:#fff;}
.btn .ic{width:13px;height:13px;}
.copy-btn.copied .ic{width:13px;height:13px;}

.chip-select{display:flex;flex-wrap:wrap;gap:8px;}
.chip-opt{border:1px solid var(--border);border-radius:0;padding:14px 16px;background:var(--surface);text-align:left;flex:1 1 210px;min-width:180px;transition:border-color .15s ease;}
.chip-opt:hover{border-color:#000;}
.chip-opt.selected{border-color:#000;background:var(--accent-soft);box-shadow:inset 0 0 0 1px #000;}
.chip-opt .co-title{font-weight:500;font-size:13.5px;margin-bottom:2px;}
.chip-opt .co-sub{font-size:12px;color:var(--ink-2);}

.field-placeholder{background:none;color:var(--ink);padding:0;font-weight:700;text-decoration:underline;text-decoration-style:dashed;text-underline-offset:3px;}

.accordion-item{border:0;border-bottom:.3px solid #000;border-radius:0;margin-bottom:0;overflow:hidden;background:var(--surface);}
.accordion-head{width:100%;display:flex;align-items:center;justify-content:space-between;gap:10px;padding:16px 4px;background:none;border:0;text-align:left;font-weight:500;font-size:14px;}
.accordion-head .chev{transition:transform .18s ease;flex:none;color:var(--ink-3);}
.accordion-head .chev .ic{width:13px;height:13px;}
.accordion-item.open .accordion-head .chev{transform:rotate(90deg);}
.accordion-body{padding:0 4px 18px;font-size:13.75px;color:var(--ink-2);display:none;}
.accordion-item.open .accordion-body{display:block;}
.accordion-body p + p{margin-top:8px;}

.template-card{border:1px solid var(--border);border-radius:0;background:var(--surface);margin-bottom:18px;overflow:hidden;}
.template-head{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:14px 18px;background:var(--surface-alt);border-bottom:.3px solid #000;}
.template-head h3{font-size:14.5px;font-weight:500;}
.template-body{padding:18px;font-size:13.75px;line-height:1.75;white-space:pre-wrap;}
.template-body .tpl-subject{font-weight:600;margin-bottom:10px;}

.copy-btn{position:relative;}
.copy-btn.copied{background:#000;border-color:#000;color:#fff;}

.tool-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;}
.tool-card{border:1px solid var(--border);border-radius:0;background:var(--surface);padding:22px;display:flex;flex-direction:column;gap:10px;box-shadow:var(--shadow-sm);transition:border-color .15s ease;}
.tool-card:hover{border-color:#000;}
.tool-card .ti{width:36px;height:36px;border-radius:0;background:var(--surface-alt);color:#000;display:flex;align-items:center;justify-content:center;}
.tool-card .ti .ic{width:19px;height:19px;}
.tool-card h3{font-size:15px;font-weight:500;}
.tool-card p{font-size:12.75px;color:var(--ink-2);flex:1;}

.stepper{display:flex;gap:6px;margin-bottom:22px;}
.stepper .st{flex:1;height:2px;border-radius:0;background:var(--border);}
.stepper .st.done{background:#000;}
.stepper .st.current{background:#000;opacity:.4;}

.wizard-footer{display:flex;justify-content:space-between;margin-top:22px;padding-top:18px;border-top:.3px solid #000;}

.result-doc{border:1px solid var(--border);border-radius:0;padding:14px 16px;margin-bottom:10px;background:var(--surface);}
.result-doc .rd-top{display:flex;justify-content:space-between;gap:10px;align-items:flex-start;margin-bottom:6px;}
.result-doc h4{font-size:14px;font-weight:500;}
.result-doc .rd-meta{display:flex;gap:14px;flex-wrap:wrap;font-size:12px;color:var(--ink-2);margin-top:8px;}
.result-doc .rd-meta strong{color:var(--ink);font-weight:600;}

.tree-node{border-left:1px dashed var(--border);margin-left:11px;padding-left:18px;}
.tree-root > .tree-node{border-left:0;margin-left:0;padding-left:0;}
.node-row{display:flex;align-items:center;gap:8px;flex-wrap:wrap;background:var(--surface);border:1px solid var(--border);border-radius:0;padding:10px 12px;margin:8px 0;}
.node-row input[type=text]{width:150px;padding:6px 9px;border:1px solid var(--border);border-radius:0;background:var(--surface-alt);}
.node-row input[type=number]{width:70px;padding:6px 8px;border:1px solid var(--border);border-radius:0;background:var(--surface-alt);}
.node-row select{padding:6px 8px;border:1px solid var(--border);border-radius:0;background:var(--surface-alt);}
.node-row.listed{border-color:var(--danger);background:var(--danger-soft);}
.node-row .nr-label{font-size:11px;letter-spacing:.03em;color:var(--ink-3);}
.node-row .pct-badge{font-weight:600;font-size:13px;}
.node-flags{display:flex;gap:6px;margin-left:auto;}

.result-panel{border-radius:0;padding:20px;border:1px solid var(--border);}
.result-panel.pct25{background:var(--surface);}
.result-panel.pct50{background:var(--surface-alt);}
.result-panel h3{font-size:11px;font-weight:500;letter-spacing:.1em;text-transform:uppercase;margin-bottom:12px;}
.calc-chain{font-family:var(--mono);font-size:12.5px;background:var(--surface);border-radius:0;padding:8px 10px;margin:4px 0;border:1px solid var(--border);}
.verdict{display:inline-flex;align-items:center;gap:6px;font-weight:600;font-size:11.5px;letter-spacing:.03em;border-radius:0;padding:6px 11px;margin-top:6px;}
.verdict.ok{background:var(--surface-alt);color:var(--ink);}
.verdict.stop{background:var(--warn-soft);color:var(--warn-ink);}
.verdict.blocked{background:var(--danger);color:#fff;}

.timeline{display:flex;align-items:flex-start;gap:0;margin:26px 0 10px;overflow-x:auto;padding-bottom:8px;}
.tl-phase{flex:1 1 0;min-width:150px;position:relative;padding:0 10px;text-align:left;background:none;border:0;}
.tl-phase .tl-dot{width:8px;height:8px;border-radius:50%;background:var(--surface);border:1.5px solid #000;margin-bottom:12px;position:relative;z-index:2;}
.tl-phase .tl-line{position:absolute;top:3px;left:-50%;right:50%;height:.6px;background:#000;z-index:1;}
.tl-phase:first-child .tl-line{display:none;}
.tl-phase .tl-name{font-weight:400;font-size:12px;letter-spacing:.04em;text-transform:uppercase;margin-bottom:4px;}
.tl-phase .tl-marks{font-size:11px;color:var(--ink-3);}
.tl-phase.active .tl-dot{background:#000;}
.tl-phase.active .tl-name{font-weight:700;}
.tl-phase:hover .tl-name{text-decoration:underline;text-underline-offset:3px;}

.track-cards{display:grid;grid-template-columns:1fr 1fr;gap:18px;}
.track-card{border-radius:0;padding:24px;border:0;border-left:3px solid;}
.track-card.trackA{background:var(--danger-soft);border-color:var(--danger);color:var(--danger-ink);}
.track-card.trackB{background:var(--warn-soft);border-color:var(--warn);color:var(--warn-ink);}
.track-card h3{font-size:15px;font-weight:600;margin-bottom:4px;}
.track-card .tc-sub{font-size:11px;font-weight:500;text-transform:uppercase;letter-spacing:.1em;opacity:.75;margin-bottom:14px;}
.track-card ol,.track-card ul{margin-top:8px;font-size:13.5px;line-height:1.7;}
.track-card .tc-note{margin-top:14px;padding-top:14px;border-top:1px solid currentColor;opacity:.9;font-size:13px;font-weight:600;}

.folder-gen{display:flex;gap:10px;flex-wrap:wrap;margin:14px 0;}
.folder-gen input{flex:1 1 200px;padding:9px 12px;border:1px solid var(--border);border-radius:0;background:var(--surface-alt);}
.folder-preview{font-family:var(--mono);background:#000;color:#fff;padding:14px 16px;border-radius:0;font-size:13.5px;margin-top:10px;word-break:break-all;}
.folder-preview .fp-static{color:#9a9a9a;}

.raci-filter-bar{display:flex;align-items:center;gap:10px;margin-bottom:14px;flex-wrap:wrap;}

.quicklinks{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:10px;}

.fade-in{animation:fadeIn .18s ease;}
@keyframes fadeIn{from{opacity:0;transform:translateY(4px);}to{opacity:1;transform:none;}}

.reminder-box{display:flex;gap:12px;align-items:flex-start;background:var(--surface-alt);border-radius:0;padding:12px 14px;margin-bottom:8px;font-size:13.25px;}
.reminder-box .rb-ic{flex:none;width:20px;height:20px;color:var(--ink);margin-top:1px;}

.faq-search{width:100%;padding:12px 16px;border:1px solid var(--border);border-radius:0;background:var(--surface);margin-bottom:16px;font-size:13.5px;}
.faq-search:focus{border-color:#000;}

.skip-link{position:absolute;left:-999px;top:0;background:#000;color:#fff;padding:10px 16px;border-radius:0;z-index:999;}
.skip-link:focus{left:0;}

/* Wizard summary tags */
.tag-list{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px;}
.tag-list .tg{font-size:10.5px;text-transform:uppercase;letter-spacing:.04em;background:var(--surface-alt);border:1px solid var(--border);padding:3px 9px;border-radius:0;}

/* ============================================================
   RESPONSIVE
   ============================================================ */
@media (max-width:1000px){
  .tool-grid{grid-template-columns:1fr;}
  .track-cards{grid-template-columns:1fr;}
  .quicklinks{grid-template-columns:1fr;}
}
@media (max-width:860px){
  :root{--sidebar-w:250px;}
