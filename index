/* ============================================================
   ROLE HIGHLIGHTING (applies across all rendered pages)
   ============================================================ */
function applyRoleHighlight(){
  const active = state.role;
  document.querySelectorAll('[data-role]').forEach(el=>{
    const r = el.getAttribute('data-role');
    if(active !== 'all' && r !== active){ el.classList.add('dim'); } else { el.classList.remove('dim'); }
  });
  document.querySelectorAll('[data-role-badge]').forEach(el=>{
    const r = el.getAttribute('data-role-badge');
    el.classList.toggle('hl', active !== 'all' && r === active);
  });
}

/* ============================================================
   MASTER RENDER
   ============================================================ */
function render(){
  document.getElementById('sidebar').innerHTML = renderSidebar();
  renderTopControls();
  const main = document.getElementById('main-content');
  main.innerHTML = renderRoute();
  main.classList.remove('fade-in'); void main.offsetWidth; main.classList.add('fade-in');
  applyRoleHighlight();
  postRenderHook();
  closeMobileSidebar();
}

function renderRoute(){
  switch(state.route){
    case 'home': return renderHome();
    case 'wizard': return renderWizard();
    case 'calculator': return renderCalculator();
    case 'role-timeline': return renderRoleTimeline();
    case 'faq': return renderFaq();
    case 'kyc-required': return renderFaq();
    case 'raci': return renderRaci();
    case 'phases': return renderPhases();
    case 'thresholds': return renderThresholds();
    case 'registries': return renderRegistries();
    case 'checklists': return renderChecklists();
    case 'payments': return renderPayments();
    case 'screening': return renderScreening();
    case 'escalation': return renderEscalation();
    case 'toolkit': return renderToolkit();
    case 'records': return renderRecords();
    default: return renderHome();
  }
}

function postRenderHook(){
  if(state.route==='calculator') mountCalculator();
  if(state.route==='records') mountRecordsGenerator();
}

