/* ============================================================
   CALCULATOR (Section 4.2 / §4.2 of brief)
   25% = multiplicative down the chain (independent)
   50% = cascades level by level, listed stakes summed per level (independent)
   ============================================================ */
function initCalc(){
  if(!state.calc){
    state.calc = { root: { id:'root', name:null, type:'root', pct:100, listed:false, children:[], effectivePct:100 } };
  }
}
function findCalcNode(node, id){
  if(node.id===id) return node;
  for(const c of node.children){ const f = findCalcNode(c, id); if(f) return f; }
  return null;
}
function findCalcParent(node, id, parent){
  if(node.id===id) return parent;
  for(const c of node.children){ const f = findCalcParent(c, id, node); if(f) return f; }
  return null;
}
function calcAddChild(parentId){
  initCalc();
  const parent = findCalcNode(state.calc.root, parentId);
  if(!parent) return;
  parent.children.push({ id: RID(), name:'', type:'company', pct:0, listed:false, children:[] });
  calcRecompute();
}
function calcRemoveNode(id){
  const parent = findCalcParent(state.calc.root, id, null);
  if(parent){ parent.children = parent.children.filter(c=>c.id!==id); calcRecompute(); }
}
function calcUpdateNode(id, patch){
  const node = findCalcNode(state.calc.root, id);
  if(node) Object.assign(node, patch);
}
function calcComputeEffective(node, parentEff){
  node.effectivePct = node.id==='root' ? 100 : parentEff * ((Number(node.pct)||0)/100);
  node.children.forEach(c=>calcComputeEffective(c, node.effectivePct));
}
function calcComputeBlocking(node){
  node.children.forEach(calcComputeBlocking);
  let sum = 0;
  node.children.forEach(c=>{ if(c.listed || c.blocked){ sum += (Number(c.pct)||0); } });
  node.aggListedPct = sum;
  node.blocked = sum >= 50;
  node.flagged = sum >= 25 && sum < 50;
}
function calcRecompute(){
  calcComputeEffective(state.calc.root, 100);
  calcComputeBlocking(state.calc.root);
  const container = document.getElementById('calcDynamic');
  if(container){
    preserveFocus('calcDynamic', ()=>{ container.innerHTML = renderCalcDynamic(); });
  }
}
function preserveFocus(containerId, updateFn){
  const root = document.getElementById(containerId);
  const active = document.activeElement;
  let focusKey = null, selStart=null, selEnd=null;
  if(root && active && root.contains(active) && active.dataset && active.dataset.focusKey){
    focusKey = active.dataset.focusKey;
    try{
      if(typeof active.selectionStart === 'number'){ selStart = active.selectionStart; selEnd = active.selectionEnd; }
    }catch(e){}
  }
  updateFn();
  if(focusKey){
    const sel = '[data-focus-key="'+focusKey.replace(/"/g,'\\"')+'"]';
    const el = document.querySelector('#'+containerId+' '+sel);
    if(el){
      el.focus();
      if(selStart!=null && el.setSelectionRange){ try{ el.setSelectionRange(selStart, selEnd); }catch(e){} }
    }
  }
}

function renderCalculator(){
  initCalc();
  calcComputeEffective(state.calc.root, 100);
  calcComputeBlocking(state.calc.root);
  const d = T().calculator, t = T();
  return `
  ${pageHead(d.eyebrow, d.title, d.subtitle)}
  <p class="muted" style="margin-bottom:16px;">${esc(d.intro)}</p>
  <div id="calcDynamic">${renderCalcDynamic()}</div>
  `;
}

function calcNodeRow(node){
  const t = T();
  const listedCls = node.listed ? 'listed' : '';
  return `<div class="tree-node">
    <div class="node-row ${listedCls}">
      <input type="text" data-focus-key="${node.id}-name" data-bind="calc-name" data-node="${node.id}" value="${esc(node.name)}" placeholder="${node.type==='person'?esc(t.ui.common.person):esc(t.ui.common.company)}">
      <select data-bind="calc-type" data-node="${node.id}">
        <option value="company" ${node.type==='company'?'selected':''}>${esc(t.ui.common.company)}</option>
        <option value="person" ${node.type==='person'?'selected':''}>${esc(t.ui.common.person)}</option>
      </select>
      <input type="text" inputmode="decimal" autocomplete="off" style="width:64px;" data-focus-key="${node.id}-pct" data-bind="calc-pct" data-node="${node.id}" value="${esc(String(node.pct))}" onfocus="this.select()"> <span class="nr-label">${esc(t.ui.common.ofParent)}</span>
      <label class="nr-label" style="display:flex;align-items:center;gap:4px;cursor:pointer;">
        <input type="checkbox" data-bind="calc-listed" data-node="${node.id}" ${node.listed?'checked':''}> ${esc(t.ui.common.markListed)}
      </label>
      <span class="pct-badge" title="Effective % of Buyer">${(node.effectivePct||0).toFixed(1)}%</span>
      <div class="node-flags">
        <button class="btn sm ghost" data-action="calc-add" data-node="${node.id}">${esc(t.ui.common.addOwner)}</button>
        <button class="btn sm danger-o" data-action="calc-remove" data-node="${node.id}">${esc(t.ui.common.remove)}</button>
      </div>
    </div>
    ${node.children.length ? node.children.map(calcNodeRow).join('') : ''}
  </div>`;
}

function calcFlattenPaths(node, path, out){
  node.children.forEach(c=>{
    const p = path.concat([c]);
    out.push(p);
    calcFlattenPaths(c, p, out);
  });
  return out;
}

function calcCollectLevels(node, out){
  if(node.children.length){
    if(node.aggListedPct>0){
      out.push({ owner: node, contributors: node.children.filter(c=>c.listed||c.blocked) });
    }
    node.children.forEach(c=>calcCollectLevels(c, out));
  }
  return out;
}

function renderCalcDynamic(){
  const t = T(), d = T().calculator;
  const root = state.calc.root;
  const treeHtml = root.children.length
    ? root.children.map(calcNodeRow).join('')
    : `<p class="muted small" style="margin:10px 0;">${esc(d.addRootPrompt)}</p>`;

  const paths = calcFlattenPaths(root, [], []);
  const p25rows = paths.filter(p => p[p.length-1].name || (Number(p[p.length-1].pct)||0) > 0).map(p=>{
    const leaf = p[p.length-1];
    const chain = p.map(n=>((Number(n.pct)||0)+'%')).join(' × ');
    const above = leaf.effectivePct >= 25;
    return `<div class="calc-chain">${esc(leaf.name || t.ui.common.company)}: ${chain} = <strong>${leaf.effectivePct.toFixed(1)}%</strong></div>
      <div class="verdict ${above?'stop':'ok'}">${above? esc(d.verdictAbove) : esc(d.verdictBelow)}</div>`;
  }).join('<div style="height:8px"></div>');

  const rootVerdict = root.blocked ? {cls:'blocked', txt:d.verdictBlocked} : root.flagged ? {cls:'stop', txt:d.verdictFlag} : {cls:'ok', txt:d.verdictClear};
  const levels = calcCollectLevels(root, []);
  const levelsHtml = levels.map(lv=>{
    const ownerName = lv.owner.id==='root' ? t.ui.common.buyer : (lv.owner.name || t.ui.common.company);
    const names = lv.contributors.map(c=>`${esc(c.name||t.ui.common.person)} (${c.pct}%)`).join(' + ');
    const verdict = lv.owner.blocked ? {cls:'blocked', txt:d.verdictBlocked} : lv.owner.flagged ? {cls:'stop', txt:d.verdictFlag} : null;
    return `<div class="calc-chain">${esc(ownerName)} ← ${names} = <strong>${lv.owner.aggListedPct.toFixed(1)}%</strong></div>${verdict?`<div class="verdict ${verdict.cls}">${esc(verdict.txt)}</div>`:''}<div style="height:8px"></div>`;
  }).join('');

  return `
  <div class="card">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;">
      <strong>${esc(t.ui.common.buyer)}</strong>
      <button class="btn sm danger-o" data-action="calc-reset">${esc(d.resetBtn)}</button>
    </div>
    <div class="tree-root">${treeHtml}</div>
    <div style="margin-top:10px;"><button class="btn sm" data-action="calc-add" data-node="root">${esc(t.ui.common.addOwner)}</button></div>
  </div>
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:18px;">
    <div class="result-panel pct25">
      <h3>${esc(d.panel25.title)}</h3>
      <p class="small muted" style="margin-bottom:10px;">${esc(d.panel25.note)}</p>
      ${p25rows || `<p class="small muted">—</p>`}
    </div>
    <div class="result-panel pct50">
      <h3>${esc(d.panel50.title)}</h3>
      <p class="small muted" style="margin-bottom:10px;">${esc(d.panel50.note)}</p>
      <div class="verdict ${rootVerdict.cls}" style="margin-bottom:10px;">${esc(rootVerdict.txt)}</div>
      ${levelsHtml || `<p class="small muted">—</p>`}
    </div>
  </div>
  <p class="small muted" style="margin-top:14px;">${esc(d.officerNote)}</p>
  <div style="display:grid;grid-template-columns:1fr;gap:0;margin-top:10px;">
    <details class="card" style="padding:14px 18px;">
      <summary style="cursor:pointer;font-weight:700;font-size:13px;">Worked examples from the guidelines</summary>
      <div class="small muted" style="margin-top:8px;line-height:1.7;">
        30% × 50% = 15% → below 25% threshold, stop documenting that branch.<br>
        Three listed persons at 20% + 20% + 15% at the same level = 55% → that company is blocked.<br>
        A listed person owning 50% of a company that owns 50% of the Buyer → blocked, cascading level by level.
      </div>
    </details>
  </div>
  `;
}
